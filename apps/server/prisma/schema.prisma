
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String  @id
  name          String?
  email         String  @unique
  emailVerified Boolean @map("email_verified")
  image         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions         Session[]
  accounts         Account[]
  workspaces       Workspace[]
  workspaceMembers WorkspaceMember[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")

  token String @unique

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@index([userId])
}

model Account {
  id String @id

  accountId  String @map("account_id")
  providerId String @map("provider_id")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken  String? @map("access_token")
  refreshToken String? @map("refresh_token")

  expiresAt DateTime? @map("expires_at")
  password  String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  @@map("accounts")
  @@index([userId])
}

model Verification {
  id String @id

  identifier String
  value      String

  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("verifications")
  @@index([identifier])
}

model Workspace {
  id                 String   @id @default(uuid())
  workspaceName      String   @map("workspace_name")
  description        String?
  isActive           Boolean  @default(true) @map("is_active")
  image              String?
  brandColor         String?  @default("#2C68F6") @map("brand_color")
  transparentSidebar Boolean? @default(true) @map("transparent_sidebar")
  sidebarFeature     String?  @default("recent") @map("sidebar_feature")
  tablesView         String?  @default("default") @map("tables_view")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  ownerId            String              @map("owner_id")
  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspaceMembers   WorkspaceMember[]
  workspaceJoinCodes WorkspaceJoinCode[]
  productCategories  ProductCategory[]
  products           Product[]
  pages              Page[]
  pageThemes         PageTheme[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  role Role @default(STAFF)

  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model WorkspaceJoinCode {
  id           String  @id @default(uuid())
  code         String  @unique
  message      String?
  isActive     Boolean @default(true) @map("is_active")
  isPersistent Boolean @default(false) @map("is_persistent")
  name         String?

  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("workspace_join_codes")
}

enum Role {
  OWNER
  MANAGER
  ADMIN
  STAFF
}

model ProductCategory {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(150)
  description String? @db.Text
  icon        String? @db.VarChar(100)

  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("product_categories")
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String?
  sku         String
  barcode     String

  purchasePrice Decimal? @map("purchase_price") @db.Decimal(15, 2)
  salePrice     Decimal? @map("sale_price") @db.Decimal(15, 2)
  stock         Int?     @default(0)
  minStock      Int?     @default(10) @map("min_stock")
  unit          String?  @default("pcs") @db.VarChar(20)
  isActive      Boolean? @default(true) @map("is_active")
  image         String?  @db.Text
  isUp          Boolean? @default(false) @map("is_up")

  categoryId  String @map("category_id")
  workspaceId String @map("workspace_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category  ProductCategory @relation(fields: [categoryId], references: [id])
  workspace Workspace       @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([categoryId])
  @@index([workspaceId, isUp, isActive])
  @@index([workspaceId, categoryId])
  @@map("products")
}

model Page {
  id          String  @id @default(uuid())
  title       String
  description String?
  icon        String?
  coverImage  String?
  isActive    Boolean @default(true)

  workspaceId String
  themeId     String?

  theme     PageTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)
  workspace Workspace  @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, title])
  @@index([workspaceId])
  @@index([themeId])
  @@map("pages")
}

model PageTheme {
  id              String    @id @default(uuid())
  name            String
  mode            ThemeMode @default(light)
  primaryColor    String
  secondaryColor  String?
  backgroundColor String?
  textColor       String?
  accentColor     String?
  borderRadius    String    @default("0.5rem")
  fontFamily      String?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  pages Page[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("page_themes")
}

enum ThemeMode {
  light
  dark
  system
}
